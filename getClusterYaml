# This script getClusterYaml simply retrieves a set of requested yaml files
# in the kubernetes cluster. 
# Planning for their careful use is needed if they are to be of benefit.
#
# Requires kubectl neat which in turn needs kubectl krew.
# See https://krew.sigs.k8s.io/docs/user-guide/setup/install/
# and https://github.com/itaysk/kubectl-neat.
#
# Create a new directory.
# Place this script in the directory.
# Execute this script in-place e.g.
# ./getClusterYaml
#
# Warning: This script over writes any existing files with the same names.
#          It does not remove files for objects not found. Thus the 
#          recommendation to use a new directory. Sometimes its important
#          to spot what's missing.
#
#          Secrets are retrieved in yaml format. They are not encrypted. 
#          Use with care.
echo "Starting cluster"
mkdir -p cluster
chmod 700 cluster
# Adjust the object list to suit your needs and environment
for n in $(kubectl get -o=name gatewayclass,namespace,clusterrole,clusterrolebinding) 
do
    subdirname=$(tr "/" "\n" <<< $n | head -n1)
    shortname=$(tr "/" "\n" <<< $n | tail -n1)
    mkdir -p cluster/$subdirname
    chmod 700 cluster/$subdirname
    kubectl get $n -o yaml | kubectl neat > cluster/$subdirname/$shortname.yaml
    chmod 600 cluster/$subdirname/$shortname.yaml
done
echo "Starting namespaces"
for ns in $(kubectl get -o name namespace)
do
  wns=$(tr "/" "\n" <<< $ns | tail -n1)
  echo "Processing namespace " $wns" objects"
# Adjust the list of objects to meet your needs
  for n in $(kubectl -n $wns get -o=name configmap,cronjob,deployment,hpa,job,pv,pvc,role,rolebinding,serviceaccount,secret,service,statefulset)
  do
      mkdir -p $(dirname $wns/$n)
      chmod 700 $wns
      chmod 700 $(dirname $wns/$n)
      kubectl -n $wns get $n -o yaml | kubectl neat > $wns/$n.yaml
      chmod 600 $wns/$n.yaml
  done
done
